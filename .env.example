# Copy this whole block into Render → Environment → paste / edit the CAPS values.

# --- required ---
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
ADMIN_CHAT_ID=PASTE_YOUR_TELEGRAM_NUMERIC_ID_HERE

# --- branding ---
BOT_NAME=Deluge
BOT_HANDLE=@DelugeBot
SUPPORT_HANDLE=@DelugeSupport
HUB_URL=https://t.me/YOUR_HUB
UPDATES_URL=https://t.me/YOUR_UPDATES
TWITTER_URL=https://x.com/YOUR_X
DOCS_URL=https://t.me/YOUR_HUB
SUPPORT_URL=https://t.me/YOUR_SUPPORT
TOS_URL=https://t.me/YOUR_HUB
MORE_LINKS_URL=https://t.me/YOUR_HUB

# --- the product people PAY for: your private call channel ---
# Create a private Telegram channel, add the bot as admin, put invite link + @username:
CALL_CHANNEL=YourCallsChannel
CALL_CHANNEL_URL=https://t.me/+YOUR_INVITE_HASH

# --- you get paid here (1% of each buy + subscription) ---
FEE_BPS=100
FEE_EVM_ADDRESS=0xYOUR_EVM_WALLET
FEE_SOL_ADDRESS=YOUR_SOL_WALLET

# Premium: $200 / 30 days, paid in native of the chain they tap (goes to FEE_*).
PREMIUM_USD=200
PREMIUM_DAYS=30
PREMIUM_FREE=0
# optional fixed native amount instead of live USD price, e.g. PREMIUM_SOL=1.5

# --- hosting (Render sets PORT + RENDER_EXTERNAL_URL itself) ---
PYTHONUNBUFFERED=1
FORCE_POLLING=0
WEBHOOK_PATH=/telegram

# --- keep wallets after redeploy (generate once, never change) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=PASTE_FERNET_KEY_HERE

# optional
# MVP_TOKEN_CA=
# MVP_TOKEN_CHAIN=ETH
# RPC_ETH=
# RPC_BSC=
# RPC_BASE=
# RPC_ARB=
# RPC_AVAX=
# RPC_SOL=
