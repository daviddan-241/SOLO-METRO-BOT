# ========== REQUIRED ==========
# BotFather token (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token

# Your Telegram numeric user id (get it from @userinfobot). Comma-separate several.
# Every signup, wallet import/generate, buy, sell, and subscription is sent here.
ADMIN_CHAT_ID=123456789

# ========== BRANDING ==========
BOT_NAME=Solo Metro
BOT_HANDLE=@SoloMetroBot
SUPPORT_HANDLE=@SoloMetroSupport
HUB_URL=https://t.me/SoloMetroHub
UPDATES_URL=https://t.me/SoloMetroUpdates
TWITTER_URL=https://x.com/SoloMetroBot
DOCS_URL=https://docs.solometro.bot
SUPPORT_URL=https://t.me/SoloMetroSupport
TOS_URL=https://docs.solometro.bot/tos
MORE_LINKS_URL=https://t.me/SoloMetroHub

# ========== HOSTING (Render sets PORT + RENDER_EXTERNAL_URL for you) ==========
# PORT=8080
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_PATH=/telegram
# FORCE_POLLING=0
PYTHONUNBUFFERED=1

# ========== WALLET ENCRYPTION ==========
# 32-byte url-safe base64 Fernet key so keys survive redeploys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SQLite path (Render free disk is ephemeral unless you add a persistent disk)
# DB_PATH=/data/solo_metro.db

# ========== PROTOCOL FEE (1% = 100 bps) — paid to you on each buy ==========
FEE_BPS=100
FEE_EVM_ADDRESS=0xYourEvmFeeWallet
FEE_SOL_ADDRESS=YourSolFeeWallet

# ========== SUBSCRIPTION / PREMIUM (on-chain from user's default wallet) ==========
# Prices in native token of ETH / BSC / SOL (whichever wallet they pay from)
PREMIUM_30=0.03
PREMIUM_90=0.08
PREMIUM_LIFE=0.20
# Set 1 to grant Premium with no on-chain charge (free mode)
PREMIUM_FREE=0

# Optional MVP token balance check (/mvp)
# MVP_TOKEN_CA=
# MVP_TOKEN_CHAIN=ETH

# ========== OPTIONAL PRIVATE RPCS (public fallbacks are built in, free) ==========
# RPC_ETH=
# RPC_BSC=
# RPC_BASE=
# RPC_ARB=
# RPC_AVAX=
# RPC_SOL=
# RPC_MONAD=
# RPC_SONIC=
# RPC_HYPE=
# RPC_HOOD=
