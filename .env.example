# Required
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token

# Optional branding
BOT_NAME=Solo Metro
BOT_HANDLE=@SoloMetroBot
SUPPORT_HANDLE=@SoloMetroSupport

# Public links used in menus
HUB_URL=https://t.me/SoloMetroHub
UPDATES_URL=https://t.me/SoloMetroUpdates
TWITTER_URL=https://x.com/SoloMetroBot
DOCS_URL=https://docs.solometro.bot
SUPPORT_URL=https://t.me/SoloMetroSupport
TOS_URL=https://docs.solometro.bot/tos
MORE_LINKS_URL=https://t.me/SoloMetroHub

# Render sets PORT and RENDER_EXTERNAL_URL automatically.
# For local webhook testing you can set:
# PORT=8080
# WEBHOOK_URL=https://your-public-url.example
# WEBHOOK_PATH=/telegram

# Optional: 32-byte url-safe base64 Fernet key. If omitted, one is derived from the bot token.
# ENCRYPTION_KEY=

# Polling vs webhook. On Render webhook is used automatically.
# FORCE_POLLING=0

# Optional 1% protocol fee (leave empty to take no fee)
# FEE_BPS=100
# FEE_EVM_ADDRESS=0xYourFeeWallet
# FEE_SOL_ADDRESS=YourSolFeeWallet

# Premium on-chain prices (paid from the user's default ETH/BSC/SOL wallet)
# PREMIUM_30=0.03
# PREMIUM_90=0.08
# PREMIUM_LIFE=0.20
# Optional MVP token balance check
# MVP_TOKEN_CA=
# MVP_TOKEN_CHAIN=ETH

# Optional private RPCs (public fallbacks are built in)
# RPC_ETH=
# RPC_BSC=
# RPC_BASE=
# RPC_ARB=
# RPC_AVAX=
# RPC_SOL=
